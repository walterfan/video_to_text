# Environment Configuration
# Copy this file to .env and fill in your configuration details

# Admin Configuration
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# Database Configuration (optional - defaults to SQLite)
# DEV_DATABASE_URL=sqlite:///video-to-text-dev.db
# TEST_DATABASE_URL=sqlite:///video-to-text-test.db
# DATABASE_URL=sqlite:///video-to-text.db

# LLM Configuration for Translation
# OpenAI-compatible API configuration
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo